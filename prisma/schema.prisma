generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  STORE_MANAGER
  STORE_STAFF
  DEPT_HEAD
  REQUESTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  DEPT_APPROVED
  STORE_REVIEWING
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
}

enum RequisitionItemStatus {
  PENDING
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  BACKORDERED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum TransactionType {
  RECEIVED
  ISSUED
  RETURNED
  ADJUSTED
  TRANSFERRED
  INITIAL_IMPORT
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  REORDER_POINT
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum LocationType {
  VESSEL
  BARGE
  SITE
  WAREHOUSE
}

// ─── USERS & AUTH ───────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  badgeNumber  String?    @unique @map("badge_number")
  role         UserRole   @default(REQUESTER)
  status       UserStatus @default(ACTIVE)
  departmentId String?    @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  requisitions         Requisition[]
  approvals            RequisitionApproval[]
  transactions         InventoryTransaction[] @relation("performed_by")
  alertRulesCreated    AlertRule[]
  notifications        Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── DEPARTMENTS ────────────────────────────────────────────────────────────

model Department {
  id          String @id @default(cuid())
  code        String @unique // SUR, ROV, RND, DIV, HSE, USV, PMT, STORE
  name        String // Survey Dept, ROV Dept, etc.
  description String?
  isStore     Boolean @default(false) @map("is_store")

  users        User[]
  requisitions Requisition[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

// ─── COMMODITY GROUPS (hierarchical categories) ─────────────────────────────

model CommodityGroup {
  id             String  @id @default(cuid())
  code           String  @unique // "38*3820"
  commodityCode  String  @map("commodity_code") // "382020"
  name           String  // human readable name
  parentId       String? @map("parent_id")
  parent         CommodityGroup?  @relation("CommodityGroupHierarchy", fields: [parentId], references: [id])
  children       CommodityGroup[] @relation("CommodityGroupHierarchy")

  items Item[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("commodity_groups")
}

// ─── ITEMS (master catalog) ─────────────────────────────────────────────────

model Item {
  id                String     @id @default(cuid())
  itemCode          String     @unique @map("item_code") // SS10000001
  description       String     @db.Text
  classDescription  String?    @map("class_description") // CARTRIDGE,PRINTER
  legacyItem        String?    @map("legacy_item")
  oldMaterialNumber String?    @map("old_material_number")

  commodityGroupId  String?    @map("commodity_group_id")
  commodityGroup    CommodityGroup? @relation(fields: [commodityGroupId], references: [id])

  manufacturer    String?
  partNumber      String?   @map("part_number")
  orderUnit       String    @default("Each") @map("order_unit")
  issueUnit       String    @default("Each") @map("issue_unit")

  reorderPoint    Int       @default(0) @map("reorder_point") // ROP
  economicOrderQty Int      @default(0) @map("economic_order_qty") // EOQ
  leadTimeDays    Int       @default(0) @map("lead_time_days")
  averageCost     Decimal   @default(0) @map("average_cost") @db.Decimal(12, 2)
  fifoUnitCost    Decimal?  @map("fifo_unit_cost") @db.Decimal(12, 2)

  criticality     Int       @default(3) // 1=highest, 3=lowest
  abcType         String?   @map("abc_type")
  isConsumable    Boolean   @default(true) @map("is_consumable")
  isConsignment   Boolean   @default(false) @map("is_consignment")
  inspectOnReceipt Boolean  @default(true) @map("inspect_on_receipt")
  isSparePart     Boolean   @default(false) @map("is_spare_part")
  lotType         String    @default("NOLOT") @map("lot_type")
  itemSet         String?   @map("item_set") // SUBSEA

  binLocation     String?   @map("bin_location")
  status          ItemStatus @default(ACTIVE)

  inventoryRecords   Inventory[]
  requisitionItems   RequisitionItem[]
  transactions       InventoryTransaction[]
  alertRules         AlertRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}

// ─── STOREROOMS ─────────────────────────────────────────────────────────────

model Storeroom {
  id          String @id @default(cuid())
  code        String @unique // SSMAIN
  name        String
  site        String @default("SS")
  description String?

  inventoryRecords Inventory[]
  transactions     InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("storerooms")
}

// ─── INVENTORY (stock levels per storeroom) ─────────────────────────────────

model Inventory {
  id              String @id @default(cuid())
  itemId          String @map("item_id")
  item            Item   @relation(fields: [itemId], references: [id])
  storeroomId     String @map("storeroom_id")
  storeroom       Storeroom @relation(fields: [storeroomId], references: [id])

  currentBalance  Int    @default(0) @map("current_balance")
  availableBalance Int   @default(0) @map("available_balance")
  physicalCount   Int?   @map("physical_count")
  lastCountedAt   DateTime? @map("last_counted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([itemId, storeroomId])
  @@map("inventory")
}

// ─── LOCATIONS (vessels, barges, sites) ─────────────────────────────────────

model Location {
  id          String       @id @default(cuid())
  name        String       // ASTRO ARCHERNER
  type        LocationType @default(VESSEL)
  region      String?      // UAE
  description String?
  isActive    Boolean      @default(true) @map("is_active")

  requisitions Requisition[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("locations")
}

// ─── PROJECTS ───────────────────────────────────────────────────────────────

model Project {
  id          String  @id @default(cuid())
  code        String  @unique // "2035"
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  requisitions Requisition[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

// ─── REQUISITIONS ───────────────────────────────────────────────────────────

model Requisition {
  id                String             @id @default(cuid())
  requisitionNumber String             @unique @map("requisition_number") // SUR-2026-0001
  revisionNumber    Int                @default(0) @map("revision_number") // REV0, REV1...
  status            RequisitionStatus  @default(DRAFT)

  requesterId       String             @map("requester_id")
  requester         User               @relation(fields: [requesterId], references: [id])
  departmentId      String             @map("department_id")
  department        Department         @relation(fields: [departmentId], references: [id])

  projectId         String?            @map("project_id")
  project           Project?           @relation(fields: [projectId], references: [id])
  locationId        String?            @map("location_id")
  location          Location?          @relation(fields: [locationId], references: [id])

  remarks           String?            @db.Text

  items             RequisitionItem[]
  approvals         RequisitionApproval[]

  submittedAt       DateTime?          @map("submitted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("requisitions")
}

// ─── REQUISITION LINE ITEMS ─────────────────────────────────────────────────

model RequisitionItem {
  id              String                @id @default(cuid())
  requisitionId   String                @map("requisition_id")
  requisition     Requisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  itemId          String                @map("item_id")
  item            Item                  @relation(fields: [itemId], references: [id])

  unit            String                @default("Each")
  quantityRequired Int                  @map("quantity_required")
  quantityIssued  Int                   @default(0) @map("quantity_issued")
  status          RequisitionItemStatus @default(PENDING)
  remarks         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("requisition_items")
}

// ─── REQUISITION APPROVALS ──────────────────────────────────────────────────

model RequisitionApproval {
  id              String         @id @default(cuid())
  requisitionId   String         @map("requisition_id")
  requisition     Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  approverId      String         @map("approver_id")
  approver        User           @relation(fields: [approverId], references: [id])

  level           Int            // 1=dept head, 2=store manager, 3=higher authority
  action          ApprovalAction
  comments        String?        @db.Text

  actedAt         DateTime       @default(now()) @map("acted_at")

  @@map("requisition_approvals")
}

// ─── INVENTORY TRANSACTIONS (audit trail) ───────────────────────────────────

model InventoryTransaction {
  id              String          @id @default(cuid())
  itemId          String          @map("item_id")
  item            Item            @relation(fields: [itemId], references: [id])
  storeroomId     String          @map("storeroom_id")
  storeroom       Storeroom       @relation(fields: [storeroomId], references: [id])

  type            TransactionType
  quantity        Int             // positive = in, negative = out
  balanceAfter    Int             @map("balance_after")

  referenceType   String?         @map("reference_type") // REQUISITION, PURCHASE_ORDER, etc.
  referenceId     String?         @map("reference_id")

  performedById   String          @map("performed_by_id")
  performedBy     User            @relation("performed_by", fields: [performedById], references: [id])

  notes           String?         @db.Text

  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

// ─── ALERT RULES ────────────────────────────────────────────────────────────

model AlertRule {
  id          String    @id @default(cuid())
  itemId      String?   @map("item_id") // null = global rule using item's ROP
  item        Item?     @relation(fields: [itemId], references: [id])
  alertType   AlertType @map("alert_type")
  threshold   Int?      // null = use item's reorderPoint
  isActive    Boolean   @default(true) @map("is_active")

  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id])

  notifications Notification[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("alert_rules")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])

  alertRuleId String?   @map("alert_rule_id")
  alertRule   AlertRule? @relation(fields: [alertRuleId], references: [id])

  title       String
  message     String    @db.Text
  isRead      Boolean   @default(false) @map("is_read")

  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}
